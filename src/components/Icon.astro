const { name } = Astro.props;
const d = paths[name] ?? paths.arrow;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={d}></path></svg
>
