---
import type { SiteContent } from '../content/site';
import { href, type Locale } from '../content/i18n';
import Icon from './Icon.astro';

interface Props {
  content: SiteContent;
  locale: Locale;
  /** Locale-free path of the current page, so the switch lands on the same page. */
  path?: string;
}

const { content, locale, path = '' } = Astro.props;
const other: Locale = locale === 'en' ? 'pt' : 'en';
---

<header class="masthead">
  <a class="brand" href={href(locale)}>
    <span class="brand-mark">PH</span>
    <span class="brand-title">/ {content.ui.masthead}</span>
  </a>
  <div class="masthead-right">
    <span class="disciplines">{content.ui.disciplines}</span>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label={content.ui.themeLabel} title={content.ui.themeLabel}>
      <Icon name="moon" />
      <Icon name="sun" />
    </button>
    <a
      class="lang-switch"
      href={href(other, path)}
      data-lang-switch
      aria-label={content.ui.switchLabel}
      hreflang={other === 'pt' ? 'pt-BR' : 'en'}>{content.ui.switchShort}</a
    >
  </div>
</header>
