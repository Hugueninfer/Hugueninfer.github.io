---
import Base from '../layouts/Base.astro';
import Masthead from './Masthead.astro';
import Sidebar from './Sidebar.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Experience from './sections/Experience.astro';
import Education from './sections/Education.astro';
import Certifications from './sections/Certifications.astro';
import Results from './sections/Results.astro';
import Projects from './sections/Projects.astro';
import Builds from './sections/Builds.astro';
import Stack from './sections/Stack.astro';
import Contact from './sections/Contact.astro';
import { getContent, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const [first, last] = content.profile.name.split(' ');
const social = content.contact.links.filter((l) => ['Email', 'GitHub', 'LinkedIn'].includes(l.label));
---

<Base locale={locale} title={content.meta.title} description={content.meta.description}>
  <a class="skip" href="#main">{content.ui.skip}</a>
  <div class="page">
    <Masthead content={content} locale={locale} />
    <div class="layout">
      <Sidebar
        eyebrow={content.ui.profile}
        title={[first, `${last}.`]}
        meta={[content.profile.role, content.profile.location]}
        nav={content.nav}
        menuLabel={content.ui.menu}
        social={social}
      />
      <main id="main">
        <Hero content={content} />
        <About content={content} />
        <Experience content={content} />
        <Education content={content} />
        <Certifications content={content} />
        <Results content={content} />
        <Projects content={content} locale={locale} />
        <Builds content={content} locale={locale} />
        <Stack content={content} />
        <Contact content={content} />
      </main>
    </div>
    <footer class="site-footer">{content.ui.footer}</footer>
  </div>
</Base>

<script src="../scripts/page.ts"></script>
