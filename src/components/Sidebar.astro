---
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string[];
  meta: string[];
  nav: { id: string; label: string }[];
  menuLabel: string;
  back?: { href: string; label: string };
  photo?: { src: string; srcset: string; alt: string };
  social?: { label: string; url?: string }[];
}

const { eyebrow, title, meta, nav, menuLabel, back, photo, social = [] } = Astro.props;
---

<aside class="sidebar">
  {
    back && (
      <a class="sidebar-back" href={back.href}>
        ← {back.label}
      </a>
    )
  }
  <p class="label">{eyebrow}</p>
  {
    photo && (
      <img
        class="sidebar-photo"
        src={photo.src}
        srcset={photo.srcset}
        sizes="96px"
        alt={photo.alt}
        width="96"
        height="120"
        fetchpriority="high"
      />
    )
  }
  <p class="sidebar-name">{title.map((line, i) => (i ? [<br />, line] : line))}</p>
  <p class="sidebar-meta">{meta.map((line, i) => (i ? [<br />, line] : line))}</p>

  <details class="index" open>
    <summary class="label">{menuLabel}</summary>
    <nav aria-label={menuLabel}>
      <ol>
        {
          nav.map((item, i) => (
            <li>
              <a href={`#${item.id}`} data-spy={item.id}>
                <span class="index-num">{String(i).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </details>

  {
    social.length > 0 && (
      <div class="sidebar-social">
        {social.map((l) => (
          <a href={l.url} aria-label={l.label} target={l.url?.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <Icon name={l.label.toLowerCase()} />
          </a>
        ))}
      </div>
    )
  }
</aside>
