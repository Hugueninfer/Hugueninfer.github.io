---
import type { SiteContent } from '../../content/site';

interface Props {
  content: SiteContent;
}

const { trajectory } = Astro.props.content;
---

<section id="trajectory" class="section">
  <p class="label">{trajectory.eyebrow}</p>
  <h2 class="section-title">{trajectory.title}</h2>
  <ol class="timeline">
    {
      trajectory.items.map((item) => (
        <li class:list={['timeline-item', `is-${item.kind}`]}>
          <div class="timeline-head">
            <h3>{item.title}</h3>
            <span class="timeline-date">{item.date}</span>
          </div>
          <p class="timeline-org">{item.org}</p>
          <ul>
            {item.points.map((p) => <li>{p}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
