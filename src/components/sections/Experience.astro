---
import type { SiteContent } from '../../content/site';
import TechIcon from '../TechIcon.astro';

interface Props {
  content: SiteContent;
}

const { experience } = Astro.props.content;
// Monogram for the company badge: an acronym as-is ("SENAI"), else initials ("FX").
const initials = (org: string) => {
  const words = org.split(/[\s—-]+/).filter((w) => /^[A-Z0-9]/.test(w));
  if (/^[A-Z]{2,5}$/.test(words[0])) return words[0];
  return words.slice(0, 2).map((w) => w[0]).join('');
};
---

<section id="experience" class="section">
  <p class="label">{experience.eyebrow}</p>
  <h2 class="section-title">{experience.title}</h2>
  <ol class="jobs">
    {
      experience.items.map((job, i) => (
        <li class="job">
          <div class="job-when">
            <span class="job-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="job-date">{job.date}</span>
            {job.current && <span class="job-current">{experience.currentLabel}</span>}
          </div>
          <div class="job-body">
            <div class="job-head">
              {job.logo ? (
                <img class="job-logo" src={job.logo} alt={`${job.org} logo`} width="56" height="56" loading="lazy" decoding="async" />
              ) : (
                <span class="job-mark" aria-hidden="true">{initials(job.org)}</span>
              )}
              <div>
                <h3 class="job-org">{job.org}</h3>
                <p class="job-role">{job.role}</p>
              </div>
            </div>
            <p class="job-summary">{job.summary}</p>
            <ul class="job-tech" aria-label={experience.techLabel}>
              {job.tech.map((tech) => (
                <li title={tech.name}>
                  <TechIcon icon={tech.icon} size={20} />
                  <span>{tech.name}</span>
                </li>
              ))}
            </ul>
            <div class="job-impact">
              <div class="job-impact-head">
                <span class="label">{experience.impactLabel}</span>
                <span class="job-metric">{job.impact.metric}</span>
                <span class="job-metric-label">{job.impact.label}</span>
              </div>
              <ul class="job-impact-details">
                {job.impact.details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
