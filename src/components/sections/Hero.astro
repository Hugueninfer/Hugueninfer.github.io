---
import type { SiteContent } from '../../content/site';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="overview" class="hero hero-split">
  <div class="hero-text">
  <p class="kicker">{content.hero.kicker}</p>
  <h1 class="hero-name">{content.profile.name}</h1>
  <dl class="hero-facts">
    {
      content.hero.facts.map((f) => (
        <div>
          <dt class="label">{f.label}</dt>
          <dd>
            {f.value}
            {'note' in f && f.note && <span class="hero-note">{f.note}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  </div>
  <figure class="hero-figure">
    <img
      class="hero-photo"
      src={content.profile.photo.src}
      srcset={content.profile.photo.srcset}
      sizes="(max-width: 900px) 220px, 300px"
      alt={content.profile.photo.alt}
      width="480"
      height="600"
      fetchpriority="high"
    />
    <figcaption>{content.profile.photo.caption}</figcaption>
  </figure>
</section>
