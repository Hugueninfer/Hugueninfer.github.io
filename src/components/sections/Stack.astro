---
import type { SiteContent } from '../../content/site';
import TechIcon from '../TechIcon.astro';

interface Props {
  content: SiteContent;
}

const { stack } = Astro.props.content;
---

<section id="stack" class="section">
  <p class="label">{stack.eyebrow}</p>
  <h2 class="section-title">{stack.title}</h2>
  <p class="lead">{stack.lead}</p>
  <div class="stack-grid">
    {
      stack.groups.map((g) => (
        <div class="stack-group">
          <h3>{g.name}</h3>
          <ul class="tech-list">
            {g.items.map((item) => (
              <li>
                <span class="tech-logos">
                  {item.icons.map((icon) => (
                    <TechIcon icon={icon} size={26} />
                  ))}
                </span>
                <span class="tech-name">{item.name}</span>
                {'note' in item && item.note && <span class="tech-note">{item.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
