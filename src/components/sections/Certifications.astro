---
import type { SiteContent } from '../../content/site';
import Icon from '../Icon.astro';

interface Props {
  content: SiteContent;
}

const { certifications, ui } = Astro.props.content;
---

<section id="certifications" class="section">
  <p class="label">{certifications.eyebrow}</p>
  <h2 class="section-title">{certifications.title}</h2>
  <ul class="certs">
    {
      certifications.items.map((c) => (
        <li class="cert">
          <span class="cert-seal" aria-hidden="true">
            <Icon name="seal" />
          </span>
          <div class="cert-body">
            <h3 class="cert-name">{c.name}</h3>
            <p class="cert-meta">{[c.issuer, c.area].filter(Boolean).join(' · ')}</p>
          </div>
          <span class="cert-year">{c.year}</span>
          {c.url && (
            <a class="cert-link" href={c.url} target="_blank" rel="noopener">
              {ui.credential} <Icon name="arrow" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
