---
import type { SiteContent } from '../../content/site';
import { href, type Locale } from '../../content/i18n';
import Icon from '../Icon.astro';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const { projectsSection: section, ui } = content;
const featured = content.projects.filter((p) => p.featured);
---

<section id="projects" class="section">
  <p class="label">{section.eyebrow}</p>
  <h2 class="section-title">{section.title}</h2>
  <div class="cases">
    {
      featured.map((p) => (
        <article class="case card-link">
          <header class="case-head">
            <p class="case-tag">{p.tag}</p>
            <h3 class="case-name">
              <a class="card-target" href={href(locale, `projects/${p.slug}/`)}>{p.name}</a>
            </h3>
            <p class="case-headline">{p.headline}</p>
            <p class="case-period">{p.period} · {p.tech.slice(0, 3).join(', ')}</p>
          </header>
          <dl class="case-blocks">
            {p.blocks.map((b) => (
              <div>
                <dt class="label">{b.label}</dt>
                <dd>{b.text}</dd>
              </div>
            ))}
          </dl>
          <footer class="case-links">
            <span class="case-more">
              {ui.caseStudy} <span aria-hidden="true">→</span>
            </span>
            {p.live && (
              <a href={p.live} target="_blank" rel="noopener">
                {ui.live} <Icon name="arrow" />
              </a>
            )}
            <a href={p.repo} target="_blank" rel="noopener">
              {ui.repo} <Icon name="arrow" />
            </a>
          </footer>
        </article>
      ))
    }
  </div>
</section>
